    <color name="widget_accent">#FF7FB0E8</color>
    <color name="widget_divider">#33FFFFFF</color>

    <!-- 应用内课表格子颜色 -->
    <color name="course_text_on_color">#FF0A2440</color>
    <color name="grid_line">#FFE2E6EC</color>
    <color name="today_row_highlight">#FFEDF3FB</color>
